# Optional Vite overrides for a local LLM BFF.
# Copy to .env.local (gitignored) and restart `npm run dev`.
# Leave unset in production — the frontend falls back to the live Vercel URLs.

VITE_BFF_CHAT_URL=http://127.0.0.1:3000/api/chat
VITE_BFF_HIGHSCORE_URL=http://127.0.0.1:3000/api/game-highscore
